{
    "include": ["./src"],
    "compilerOptions": {
        "lib": ["ES2024", "DOM"],
        "target": "ES2022",
        "module": "Node20",
        "moduleResolution": "Node16",
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "declaration": true
    }
}
